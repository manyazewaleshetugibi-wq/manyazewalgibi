{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install --legacy-peer-deps",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "env": {
    "S3_BUCKET_NAME": "eresto",
    "S3_BASE_URL": "https://fly.storage.tigris.dev",
    "VERCEL_FORCE_NO_BUILD_CACHE": "1",
    "NEXT_TURBOPACK": "0",
    "NEXT_PRIVATE_LOCAL_WEBPACK": "1"
  },
  "images": {
    "domains": ["fly.storage.tigris.dev"],
    "sizes": [16, 32, 48, 64, 96, 128, 256, 384, 512, 1024, 2048]
  },
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10,
      "memory": 1024
    },
    "api/**/*.ts": {
      "maxDuration": 10,
      "memory": 1024
    }
  },
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}