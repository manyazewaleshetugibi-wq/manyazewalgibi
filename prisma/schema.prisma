  isAdminCreated   Boolean?
  createdAt        DateTime?
  updatedAt        DateTime?
  isActive         Boolean?
  version          Float?
  updatedBy        String?

  @@map("standards")
}

model Book {
  id             String    @id
  title          String?
  price          Float?
  category       String?
  imageUrl       String?
  cloudinaryData Json?
