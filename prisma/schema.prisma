}

model Order {
  id                      String    @id
  orderNumber             String?
  tableNumber             String?
  tableId                 Json?
  restaurantId            String?
  restaurantName          String?
  floor                   Json?
  arrangementId           Json?
  tableCapacity           Json?
  tableLocation           Json?
  tableFeatures           Json?
  tableShape              Json?
  waiterId                String?
  waiterName              String?
  customerId              String?
  userId                  String?
  numberOfGuests          Float?
  items                   Json?
  subtotal                Float?
  tax                     Float?
  totalAmount             Float?
  discount                Float?
  finalAmount             Float?
  deliveryFee             Float?
  packagingCharge         Float?
  categoryChargesTotal    Float?
  paymentMethod           String?
  status                  String?
  specialRequirements     String?
  isActive                Boolean?
  stockProcessed          Boolean?
  hasPartialStock         Boolean?
  pendingStockItems       Json?
  bookStockProcessed      Boolean?
  stockProcessingError    String?
  stockProcessingFailedAt DateTime?
  inTable                 Boolean?
  delivery                Boolean?
  deliveryInfo            Json?
  paymentScreenshotUrl    Json?
  markedForDeletion       Boolean?
  deletionRequestReason   Json?
  deletionRequestedBy     Json?
  deletionRequestedAt     Json?
  deletedAt               Json?
  deletedBy               Json?
  deletionReason          Json?
  createdAt               DateTime?
  updatedAt               DateTime?
  completedAt             DateTime?
  stockProcessedAt        DateTime?
  createdBy               Json?
  creatorTracked          Boolean?
  creatorTrackedAt        DateTime?
  stockProcessingNote     String?
  editRequest             Json?
  assignmentRequest       Json?
  notifications           Json?
  customerName            String?
  notes                   String?
  paymentStatus           String?
  orderItems              Json?
  updatedBy               Json?
  calculated              Boolean?
  completedBy             Json?
  completionRegistered    Boolean?
  completionRegisteredAt  DateTime?
  employeePointsAwarded   Float?
  waitressPointsAwarded   Float?
  completedOrdersIncremented Boolean?
  registrationFixed       Boolean?
  registrationFixedAt     DateTime?
  pointsAwardedOnFix      Float?
  waitressActivityRegistered Boolean?
  transactionId           String?
  deliveryAddress         String?
  note                    String?
  cancellationReason      String?
  cancelledBy             String?
  cancelledAt             DateTime?

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

