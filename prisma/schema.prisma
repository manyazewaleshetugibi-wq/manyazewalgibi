generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StockTransfer {
  id           String    @id
  stockId      String?
  quantity     Float?
  receiverName String?
  note         String?
  date         String?
  createdAt    DateTime?
  updatedAt    DateTime?

  @@map("stock_transfers")
}

model EmployeeRank {
  id               String    @id
  userId           String?
  name             String?
  email            String?
  role             String?
  employeeId       String?
  points           Float?
  totalPoints      Float?
  completedOrders  Float?
  totalOrders      Float?
  createdAt        DateTime?
  updatedAt        DateTime?
  lastActivity     DateTime?
  lastActivityType String?
  lastOrderId      String?
  lastOrderNumber  String?
  activityHistory  Json?
  department       String?
  performanceScore Float?
  attendance       Float?
  efficiency       Float?
  salesTarget      Float?
  salesAchieved    Float?
  customerRating   Float?
  rank                   Float?
  roleRank               Float?
  globalRank             Float?
  lastUpdated            DateTime?
  recalculatedAt         DateTime?
  totalOrdersProcessed   Float?
  acceptedOrders         Float?
  cancelledOrders        Float?
  deliveredOrders        Float?

  @@map("employee_rank")
}

model Feedback {
  id         String    @id
  fullName   String?
  message    String?
  visibility String?
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("feedback")
}

model DeletionRequest {
  id             String    @id
  orderId        String?
  reason         String?
  requestedBy    String?
